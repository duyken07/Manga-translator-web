# Thư mục dữ liệu (SQLite + ảnh + cache redraw) và model: PHẢI persistent, không đặt trong thư mục tạm
MT_DATA_DIR=./data
MODEL_DIR=./models
MT_FONT_DIR=./fonts

# Token API tĩnh (một người dùng). Để trống -> tự sinh vào data/api_token.txt lần chạy đầu
MT_API_TOKEN=

MT_HOST=127.0.0.1
MT_PORT=8000
MT_CORS_ORIGINS=http://localhost:5173
MT_MAX_UPLOAD_MB=40
MT_MAX_IMAGE_PIXELS=120000000
MT_TRANSLATE_CONCURRENCY=4
# 1 = không bao giờ gọi mạng (chỉ dùng model đã có trong MODEL_DIR)
MT_HF_OFFLINE=0
